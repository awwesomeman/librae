# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin

# TimescaleDB
# POSTGRES_PASSWORD=quant_secret（改這個需同步改 timescaledb.yaml）
TSDB_BIND=127.0.0.1  # Tailscale: 100.x.x.x, 開發: 0.0.0.0

# Telegram（sim/live 模式推播用）
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sim（由 sim_start.sh 管理，參數透過命令列傳入）
# ./deploy/sim_start.sh <strategy> [symbol] [poll_interval]
