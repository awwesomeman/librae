# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin

# TimescaleDB（在 docker-compose.yml 裡直接設定，非 .env）
# POSTGRES_PASSWORD=quant_secret（改這個需同步改 timescaledb.yaml）

