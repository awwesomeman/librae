# =============================================================================
# librae 環境變數最小範本（由 `librae init` 產生）
# 複製為 .env 後填入實際值，並自行載入（例如 `uv run --env-file .env ...`、
# direnv，或在你自己的程式進入點呼叫 python-dotenv 的 load_dotenv()）——
# librae 本身不會自動尋找或讀取任何 .env 檔案。
#
# 這裡只列出 librae 套件自己的程式碼會讀的變數（db/、brokers/、
# notifications/）。docker-compose、Grafana 等部署專用設定不在這份範本
# 裡——那些屬於 clone 這個 repo 後才用得到的 deploy/ 範例，見該目錄下的
# .env.example。
# =============================================================================

# === Database（db/） ===
TIMESCALE_DSN=postgresql://user:password@localhost:5432/dbname

# === Telegram（notifications/telegram.py） ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Binance（brokers/crypto_adapter.py，CCXT） ===
# 唯讀（抓資料/回測）不需要填 key。
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_EXCHANGE_ID=binance
BINANCE_SANDBOX=false

# === Shioaji（brokers/shioaji_adapter.py，Sinopac 台股/台指期） ===
# 沒有 CA_PATH 時 ShioajiAdapter 會自動進 read-only 模式。
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_PERSON_ID=
SHIOAJI_CA_PATH=
SHIOAJI_CA_PASSWORD=
SHIOAJI_SANDBOX=false

# === IBKR（brokers/ibkr_adapter.py，走 TWS / IB Gateway socket API） ===
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
