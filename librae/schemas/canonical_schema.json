{
  "schema_version": "1.0.0",
  "compatibility_policy": {
    "rule": "major-only",
    "description": "Major version bump is breaking. Minor/Patch are backward-compatible additive or fix-only changes."
  },
  "measurements": {
    "strategy_signals": {
      "tags": [
        {"name": "schema_version", "type": "str", "required": true},
        {"name": "strategy", "type": "str", "required": true},
        {"name": "symbol", "type": "str", "required": true},
        {"name": "timeframe", "type": "str", "required": true},
        {"name": "side", "type": "str", "required": true},
        {"name": "source", "type": "str", "required": true},
        {"name": "run_id", "type": "str", "required": true},
        {"name": "signal_type", "type": "str", "required": true}
      ],
      "fields": [
        {"name": "signal_strength", "type": "float", "required": true, "unit": "score"},
        {"name": "confidence", "type": "float", "required": false, "unit": "ratio_0_1"},
        {"name": "price", "type": "float", "required": false, "unit": "quote_ccy"},
        {"name": "quantity", "type": "float", "required": false, "unit": "contract_or_asset_qty"}
      ]
    },
    "strategy_performance": {
      "tags": [
        {"name": "schema_version", "type": "str", "required": true},
        {"name": "strategy", "type": "str", "required": true},
        {"name": "symbol", "type": "str", "required": true},
        {"name": "timeframe", "type": "str", "required": true},
        {"name": "run_id", "type": "str", "required": true},
        {"name": "sample", "type": "str", "required": true},
        {"name": "benchmark", "type": "str", "required": true}
      ],
      "fields": [
        {"name": "total_return", "type": "float", "required": true, "unit": "ratio"},
        {"name": "annual_return", "type": "float", "required": true, "unit": "ratio"},
        {"name": "sharpe", "type": "float", "required": true, "unit": "score"},
        {"name": "sortino", "type": "float", "required": true, "unit": "score"},
        {"name": "calmar", "type": "float", "required": true, "unit": "score"},
        {"name": "max_drawdown", "type": "float", "required": true, "unit": "ratio"},
        {"name": "win_rate", "type": "float", "required": true, "unit": "ratio_0_1"},
        {"name": "profit_factor", "type": "float", "required": true, "unit": "ratio"},
        {"name": "exposure_ratio", "type": "float", "required": true, "unit": "ratio_0_1"},
        {"name": "trades", "type": "int", "required": true, "unit": "count"}
      ]
    },
    "perf_equity_curve": {
      "tags": [
        {"name": "schema_version", "type": "str", "required": true},
        {"name": "strategy", "type": "str", "required": true},
        {"name": "symbol", "type": "str", "required": true},
        {"name": "timeframe", "type": "str", "required": true},
        {"name": "run_id", "type": "str", "required": true},
        {"name": "sample", "type": "str", "required": true},
        {"name": "benchmark", "type": "str", "required": true}
      ],
      "fields": [
        {"name": "equity", "type": "float", "required": true, "unit": "index"},
        {"name": "ret_1d", "type": "float", "required": true, "unit": "ratio"},
        {"name": "drawdown", "type": "float", "required": true, "unit": "ratio"},
        {"name": "benchmark_equity", "type": "float", "required": true, "unit": "index"},
        {"name": "benchmark_ret_1d", "type": "float", "required": true, "unit": "ratio"}
      ]
    }
  },
  "records": {
    "signal_required_keys": ["timestamp", "strategy", "symbol", "side", "timeframe"],
    "strategy_context_required_keys": [
      "benchmark",
      "data_source",
      "data_version",
      "last_updated_utc",
      "summary",
      "universe",
      "session_rules",
      "periods",
      "cost_model",
      "risk_limits",
      "assumptions",
      "logic",
      "params"
    ],
    "strategy_context_summary_required_keys": ["full_sample_period", "train_period", "oos_period", "asset", "freq"],
    "performance_required_fields": [
      "total_return",
      "max_drawdown",
      "sharpe",
      "sortino",
      "calmar",
      "profit_factor",
      "win_rate",
      "avg_trade_return",
      "trades",
      "exposure_ratio"
    ],
    "backtest_output_required_top_level": ["schema_version", "run_metadata", "equity_curve", "trades", "metrics"]
  }
}
