# One trading account's credentials — copy to .credentials/<account>.env and
# fill in real values by hand on each machine that runs that account:
#
#   cp .env.credentials.example .credentials/ibkr-main.env
#   chmod 600 .credentials/ibkr-main.env
#
# trade.sh passes the file you select with --credentials to Docker using
# --env-file, and never sources it as shell code.
#
# One file per account, and nothing shared in it. The database passwords,
# Telegram bot token and Tailscale key are one set per deployment and live in
# .env.secrets — copying those in here would put the same password in as many
# files as you have accounts, and rotating it would then mean finding them all.

# Binance: grant trading only, disable withdrawals, and restrict the key to
# the machine's public IP. Data-only use does not require credentials.
#
# BINANCE_SANDBOX=true -> Binance "Demo Trading" (demo.binance.com, same
# login as your regular account), not the old testnet.binance.vision.
# Spot and USDM-futures Demo Trading need separate keys (check "允許合約"
# for futures) even though mainnet/demo and spot/futures share one login.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SANDBOX=false

# Shioaji: use read-only credentials without a CA for data access. Live
# trading also requires the CA file under the ignored .secrets/ directory,
# which trade.sh mounts read-only when SHIOAJI_CA_PATH points below it.
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_PERSON_ID=
SHIOAJI_CA_PATH=.secrets/Sinopac.pfx
SHIOAJI_CA_PASSWORD=
SHIOAJI_SANDBOX=false

# IBKR connects to an authenticated TWS or IB Gateway session.
# TWS ports: 7497 paper, 7496 live. Gateway ports: 4002 paper, 4001 live.
# For a gateway on the Docker host, use host.docker.internal; trade.sh adds the
# Linux host-gateway mapping. For a gateway container on quant_network, use its
# service name. Leave this empty when the account does not use IBKR.
IBKR_HOST=
IBKR_PORT=7497
IBKR_CLIENT_ID=1
# Required only when IBKR_PORT is not one of 7497/4002 (paper) or 7496/4001 (production).
# IBKR_ENVIRONMENT=paper
