    {
      "title": "Unrealized PnL",
      "type": "stat",
      "targets": [
        {
          "rawSql": "WITH pos AS (\n  SELECT side, entry_price, quantity\n  FROM trade_blotter\n  WHERE run_id = '${run_id}' AND exit_ts IS NULL\n  ORDER BY entry_ts DESC LIMIT 1\n),\nlatest AS (\n  SELECT close FROM ohlcv\n  WHERE symbol = (SELECT symbol FROM backtest_runs WHERE run_id='${run_id}')\n    AND timeframe = (SELECT timeframe FROM backtest_runs WHERE run_id='${run_id}')\n  ORDER BY ts DESC LIMIT 1\n)\nSELECT CASE WHEN p.side='long'\n  THEN (l.close - p.entry_price) * p.quantity\n  ELSE (p.entry_price - l.close) * p.quantity\n  END AS \"PnL\"\nFROM pos p, latest l",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P40AE60E18F02DE32"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "red",
                "value": -100
              },
              {
                "color": "yellow",
                "value": 0
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "noValue": "No Position"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Unrealized P&L of the current open position.",
