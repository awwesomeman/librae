    {
      "title": "Price Trend",
      "description": "Close price for every run symbol, matched by timeframe and data source.",
      "type": "timeseries",
      "targets": [
        {
          "rawSql": "WITH meta AS ( SELECT symbols, timeframe, data_source, started_at, ended_at FROM backtest_runs WHERE run_id = '${run_id}') SELECT o.ts AS time, o.close, o.symbol AS metric FROM ohlcv o, meta m WHERE o.symbol IN (SELECT jsonb_array_elements_text(m.symbols)) AND o.timeframe = m.timeframe AND (m.data_source IS NULL OR o.data_source = m.data_source) AND (m.started_at IS NULL OR o.ts >= m.started_at) AND (m.ended_at IS NULL OR o.ts <= m.ended_at) AND $__timeFilter(o.ts) ORDER BY o.ts",
          "format": "time_series",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P40AE60E18F02DE32"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "showPoints": "never"
