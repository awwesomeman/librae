# =============================================================================
# quant-strategy-lab 環境變數範本
# 複製為 .env 後填入實際值：cp .env.example .env
# =============================================================================

# === Database ===
TIMESCALE_DSN=postgresql://quant:quant_secret@localhost:5432/quant
POSTGRES_PASSWORD=quant_secret

# === Grafana ===
GF_SECURITY_ADMIN_PASSWORD=admin
GRAFANA_URL=http://localhost:3000
GRAFANA_PASSWORD=admin
# Grafana datasource 連線目標：
#   VPS 部署：不需設定，預設 quant_timescaledb（Docker 內部網路）
#   本地開發：設為 VPS IP（例如 100.x.x.x）
# VPS_DB_HOST=100.x.x.x

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Shioaji (Sinopac, tw_futures sim/live) ===
# Local-only — never set these on the VM, auth happens on the dev machine.
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_PERSON_ID=
# CA cert is required for order placement (live mode); omit for read-only market data.
SHIOAJI_CA_PATH=
SHIOAJI_CA_PASSWORD=

# === Deploy（docker-compose only）===
TSDB_BIND=127.0.0.1
# TSDB_PORT=5432   # 改這個而不是 TIMESCALE_DSN 的 port，避免跟本機其他 Postgres 衝突
# TS_AUTHKEY=

# === Sim image registry（免 repo 部署 sim 用，見 deploy/build_push_sim.sh）===
# 本機 build+push、VM 端 sim_start.sh pull——不設就照舊在本機 build。
# SIM_IMAGE=ghcr.io/<github-user>/quant-sim
