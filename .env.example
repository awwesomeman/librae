# =============================================================================
# quant-strategy-lab 環境變數範本
# 複製為 .env.local（本機開發）或 deploy/.env（VPS/Docker）
# =============================================================================

# === Database ===
TIMESCALE_DSN=postgresql://quant:quant_secret@localhost:5432/quant
POSTGRES_PASSWORD=quant_secret

# === Grafana ===
GF_SECURITY_ADMIN_PASSWORD=admin
GRAFANA_URL=http://localhost:3000
GRAFANA_PASSWORD=admin

# === Telegram（credentials only — 行為開關在 strategies/*/config.yaml 的 telegram: 區塊）===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Deploy（docker-compose only）===
TSDB_BIND=127.0.0.1  # Tailscale: 100.x.x.x, 開發: 0.0.0.0
# TS_AUTHKEY=         # Tailscale auth key（僅 VPS 需要）
