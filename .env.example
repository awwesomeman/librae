# =============================================================================
# librae 環境變數範本 — 給「clone 這個 repo，用 deploy/ 下的 docker-compose /
# trade.sh 部署」這種工作流用。複製為 .env 後填入實際值：cp .env.example .env
#
# 只是 `pip install librae` 當函式庫用、沒有 clone 這個 repo？deploy/ 底下的
# docker-compose/Grafana 這些內容都用不到——執行 `librae init` 產生一份只含
# db/broker/telegram 這幾個 librae 自己會讀的變數的最小範本即可。
#
# 有實際交易/簽章能力的密鑰（BINANCE_API_KEY/BINANCE_API_SECRET、
# SHIOAJI_*）都不在這份檔案裡——這份 .env 會被 deploy/cloud_deploy.sh 整份
# scp 到 VM 上覆蓋掉，放敏感密鑰在這裡等於任何機器都可能意外持有一份。
# 這些密鑰只放在 .env.secrets（範本見 .env.secrets.example），那個檔案永遠
# 不會被任何 deploy 腳本同步，只能在需要它的那台機器上手動建立。
# =============================================================================

# === Database ===
TIMESCALE_DSN=postgresql://quant:quant_secret@localhost:5432/quant
POSTGRES_PASSWORD=quant_secret

# === Grafana ===
GF_SECURITY_ADMIN_PASSWORD=admin
GRAFANA_URL=http://localhost:3000
GRAFANA_PASSWORD=admin
# Grafana datasource 連線目標：
#   VPS 部署：不需設定，預設 quant_timescaledb（Docker 內部網路）
#   本地開發：設為 VPS IP（例如 100.x.x.x）
# VPS_DB_HOST=100.x.x.x

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Binance (CCXT, spot sim/live) ===
# read-only（抓資料/回測）不需要 key，這兩個非敏感設定可以放心跟著 .env 同步。
# BINANCE_API_KEY/BINANCE_API_SECRET 見 .env.secrets.example。
BINANCE_EXCHANGE_ID=binance
BINANCE_SANDBOX=false

# === Shioaji (Sinopac, tw_futures sim/live) ===
# All fields (login key/secret + CA cert) live in .env.secrets, not here.
# Local-only for now — deploy/trade.sh doesn't inject these on the VM yet.
# Putting the CA cert on a VM is an open risk call, not yet decided.

# === Deploy（docker-compose only）===
TSDB_BIND=127.0.0.1
# TSDB_PORT=5432   # 改這個而不是 TIMESCALE_DSN 的 port，避免跟本機其他 Postgres 衝突
# TS_AUTHKEY=

# === Trade image registry（免 repo 部署 sim/live 用，見 deploy/build_push.sh）===
# 本機 build+push、VM 端 trade.sh pull——不設就照舊在本機 build。
# TRADE_IMAGE=ghcr.io/<github-user>/quant-trade
