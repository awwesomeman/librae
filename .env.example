# =============================================================================
# librae env template — for the "clone this repo, deploy with the
# docker-compose / trade.sh under deploy/" workflow. Copy to .env and fill in
# real values: cp .env.example .env
#
# Just using `pip install librae` as a library, no clone? You don't need any
# of this — run `librae init` for a minimal template with only the
# db/broker/telegram variables librae itself reads.
#
# Keys with real trading/signing capability (BINANCE_API_KEY/
# BINANCE_API_SECRET, SHIOAJI_*) are NOT in this file — this .env gets
# scp'd wholesale to the VM by deploy/cloud_deploy.sh, so any secret placed
# here risks ending up on every machine that syncs it. Those keys live only
# in .env.secrets (template: .env.secrets.example), which no deploy script
# ever syncs and must be created by hand on the machine that needs it.
#
# Deploying to any host with a public IP? The passwords below are
# placeholders and the *_BIND defaults are just safe defaults, not a
# substitute for review — go through SECURITY.md first. Don't ship this
# template as-is.
# =============================================================================

# === Database ===
# quant is reserved for migrations, quant_app is the application writer,
# and grafana_reader is read-only.
# Host-side tools connect through the published loopback port. Trade containers
# use the service identity on quant_network instead of their own loopback.
TIMESCALE_DSN=postgresql://quant_app:quant_app_secret@localhost:5432/quant
TRADE_TIMESCALE_DSN=postgresql://quant_app:quant_app_secret@quant_timescaledb:5432/quant
POSTGRES_APP_PASSWORD=quant_app_secret
POSTGRES_GRAFANA_PASSWORD=grafana_reader_secret
POSTGRES_PASSWORD=quant_secret

# === Grafana ===
GF_SECURITY_ADMIN_PASSWORD=admin
GF_BIND=127.0.0.1
GRAFANA_URL=http://localhost:3000
# Grafana datasource target:
#   VPS deployment: leave unset, defaults to quant_timescaledb (Docker internal network)
#   Local development: set to the VPS IP (e.g. 100.x.x.x)
# VPS_DB_HOST=100.x.x.x

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Binance (CCXT, spot sim/live) ===
# Read-only use (fetching data/backtesting) needs no key, so these two
# non-sensitive settings are fine to sync via .env.
# BINANCE_API_KEY/BINANCE_API_SECRET/BINANCE_SANDBOX live in
# .env.secrets.example.
BINANCE_EXCHANGE_ID=binance

# === Shioaji (Sinopac, tw_futures sim/live) ===
# All fields (login key/secret + CA cert) live in .env.secrets, not here.
# deploy/trade.sh injects these values and mounts .secrets read-only when
# SHIOAJI_CA_PATH points to a file below that directory.

# === Deploy (docker-compose only) ===
TSDB_BIND=127.0.0.1
# TSDB_PORT=5432   # change this, not TIMESCALE_DSN's port, to avoid clashing with a local Postgres
# TS_AUTHKEY=

# === Trade image registry (for repo-less sim/live deploys, see deploy/build_push.sh) ===
# Local path containing <strategy>/__init__.py, run.py, and config.yaml.
# Relative paths resolve from the Librae checkout; default: ../strategies.
# TRADE_STRATEGY_PATH=../strategies
# TRADE_IMAGE is the registry repository used by build_push.sh.
# TRADE_IMAGE=ghcr.io/<github-user>/quant-trade
# TRADE_IMAGE_REF is the exact digest printed by build_push.sh and selected by
# trade.sh. Leave both unset to build from local checkouts.
# TRADE_IMAGE_REF=ghcr.io/<github-user>/quant-trade@sha256:<64-hex-digest>
