# =============================================================================
# quant-strategy-lab 環境變數範本
# 複製為 .env 後填入實際值：cp .env.example .env
# =============================================================================

# === Database ===
TIMESCALE_DSN=postgresql://quant:quant_secret@localhost:5432/quant
POSTGRES_PASSWORD=quant_secret

# === Grafana ===
GF_SECURITY_ADMIN_PASSWORD=admin
GRAFANA_URL=http://localhost:3000
GRAFANA_PASSWORD=admin
# Grafana datasource 連線目標：
#   VPS 部署：不需設定，預設 quant_timescaledb（Docker 內部網路）
#   本地開發：設為 VPS IP（例如 100.x.x.x）
# VPS_DB_HOST=100.x.x.x

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Deploy（docker-compose only）===
TSDB_BIND=127.0.0.1
# TS_AUTHKEY=
