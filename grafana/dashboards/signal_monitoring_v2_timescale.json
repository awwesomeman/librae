{
  "uid": "signal_monitoring_v2_ts",
  "title": "Quant Strategy Monitor v2 (TimescaleDB)",
  "description": "SQL-based strategy monitoring dashboard backed by TimescaleDB",
  "tags": ["quant", "timescaledb", "strategy"],
  "timezone": "browser",
  "editable": true,
  "time": {
    "from": "now-180d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "run_id",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "${DS_TIMESCALEDB}"
        },
        "query": "SELECT run_id FROM backtest_runs ORDER BY run_ts DESC LIMIT 20",
        "refresh": 1,
        "sort": 0,
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Return",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
      "targets": [
        {
          "rawSql": "SELECT total_return FROM strategy_performance WHERE run_id = '$run_id'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0 },
              { "color": "green", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Win Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
      "targets": [
        {
          "rawSql": "SELECT win_rate FROM strategy_performance WHERE run_id = '$run_id'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.4 },
              { "color": "green", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Max Drawdown",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
      "targets": [
        {
          "rawSql": "SELECT max_drawdown FROM strategy_performance WHERE run_id = '$run_id'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Sharpe Ratio",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
      "targets": [
        {
          "rawSql": "SELECT sharpe FROM strategy_performance WHERE run_id = '$run_id'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 1.0 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Trade Count",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
      "targets": [
        {
          "rawSql": "SELECT trades FROM strategy_performance WHERE run_id = '$run_id'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 10,
      "title": "Equity Curve",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
      "targets": [
        {
          "rawSql": "SELECT ts AS time, equity AS \"Strategy\", benchmark_equity AS \"BTC Buy&Hold\" FROM equity_curve WHERE run_id = '$run_id' AND ts BETWEEN $__timeFrom() AND $__timeTo() ORDER BY ts",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "scheme",
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Strategy" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "BTC Buy&Hold" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 11,
      "title": "Drawdown",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
      "targets": [
        {
          "rawSql": "SELECT ts AS time, drawdown * -1 AS \"Drawdown %\" FROM equity_curve WHERE run_id = '$run_id' AND ts BETWEEN $__timeFrom() AND $__timeTo() ORDER BY ts",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 30,
            "fillBelowTo": "Drawdown %",
            "showPoints": "never"
          },
          "color": { "fixedColor": "red", "mode": "fixed" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 12,
      "title": "Entry / Exit Signals",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
      "targets": [
        {
          "rawSql": "SELECT ts AS time, price AS \"Entry\" FROM strategy_signals WHERE run_id = '$run_id' AND signal_type = 'entry' AND ts BETWEEN $__timeFrom() AND $__timeTo() ORDER BY ts",
          "format": "time_series",
          "refId": "A"
        },
        {
          "rawSql": "SELECT ts AS time, price AS \"Exit\" FROM strategy_signals WHERE run_id = '$run_id' AND signal_type = 'exit' AND ts BETWEEN $__timeFrom() AND $__timeTo() ORDER BY ts",
          "format": "time_series",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "showPoints": "always",
            "pointSize": 8
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Entry" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } },
              { "id": "custom.pointSize", "value": 10 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Exit" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.pointSize", "value": 10 }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 13,
      "title": "Trade Detail",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
      "targets": [
        {
          "rawSql": "SELECT entry_ts AS \"Entry Time\", exit_ts AS \"Exit Time\", side AS \"Side\", entry_price AS \"Entry Price\", exit_price AS \"Exit Price\", ROUND(quantity::numeric, 2) AS \"Qty\", holding_bars AS \"Bars\", ROUND(((exit_price - entry_price) / entry_price * 100)::numeric, 2) AS \"Gross Return %\", ROUND((net_pnl / (entry_price * quantity) * 100)::numeric, 2) AS \"Net Return %\" FROM trade_blotter WHERE run_id = '$run_id' ORDER BY entry_ts DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Gross Return %" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "green", "value": 0 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Entry Time", "desc": true }]
      }
    }
  ],
  "__inputs": [
    {
      "name": "DS_TIMESCALEDB",
      "label": "TimescaleDB",
      "description": "",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "schemaVersion": 39,
  "version": 1
}
