# Secrets that must never be synced by a deploy script — copy this file to
# .env.secrets and fill in real values by hand on each machine that needs it
# (dev laptop, VM). Two unrelated kinds of secret share this file:
#
# 1. Trading credentials (below): per-account, copied from .env.secrets into
#    one .credentials/<account>.env file per account; trade.sh passes only
#    the explicitly selected file to Docker with --env-file and never sources
#    .env.secrets itself as shell code.
# 2. Shared infra secrets (bottom section): read directly from .env.secrets
#    by cloud_deploy.sh, db_backup.sh, and db_restore.sh via --env-file/source
#    — one shared value per deployment, not per account.

# Binance: grant trading only, disable withdrawals, and restrict the key to
# the machine's public IP. Data-only use does not require credentials.
#
# BINANCE_SANDBOX=true -> Binance "Demo Trading" (demo.binance.com, same
# login as your regular account), not the old testnet.binance.vision.
# Spot and USDM-futures Demo Trading need separate keys (check "允許合約"
# for futures) even though mainnet/demo and spot/futures share one login.
# Keep only one BINANCE_API_KEY/SECRET pair here at a time.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SANDBOX=false

# Shioaji: use read-only credentials without a CA for data access. Live
# trading also requires the CA file under the ignored .secrets/ directory.
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_PERSON_ID=
SHIOAJI_CA_PATH=.secrets/Sinopac.pfx
SHIOAJI_CA_PASSWORD=
SHIOAJI_SANDBOX=false

# IBKR connects to an authenticated TWS or IB Gateway session.
# TWS ports: 7497 paper, 7496 live. Gateway ports: 4002 paper, 4001 live.
# For a gateway on the Docker host, use host.docker.internal; trade.sh adds the
# Linux host-gateway mapping. For a gateway container on quant_network, use its
# service name. Leave this empty when the deployment does not use IBKR.
IBKR_HOST=
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# === Docker Compose infra secrets (shared, one set per deployment) ===
# Must match the values the TimescaleDB volume was initialized with —
# changing these later does not rotate existing roles (see SECURITY.md).
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_GRAFANA_PASSWORD=
GF_SECURITY_ADMIN_PASSWORD=
