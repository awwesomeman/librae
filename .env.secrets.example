# Trading credentials belong only on the machine that uses them. Copy this
# file to .env.secrets locally; never sync it between machines.
# deploy/trade.sh loads it together with .env.

# Binance: grant trading only, disable withdrawals, and restrict the key to
# the machine's public IP. Data-only use does not require credentials.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SANDBOX=false

# Shioaji: use read-only credentials without a CA for data access. Live
# trading also requires the CA file under the ignored .secrets/ directory.
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_PERSON_ID=
SHIOAJI_CA_PATH=.secrets/Sinopac.pfx
SHIOAJI_CA_PASSWORD=
SHIOAJI_SANDBOX=false

# IBKR connects to an authenticated TWS or IB Gateway session.
# TWS ports: 7497 paper, 7496 live. Gateway ports: 4002 paper, 4001 live.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
