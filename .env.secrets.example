# =============================================================================
# 有實際交易/簽章能力的密鑰範本 — 只填在需要它們的那台機器上，本機/VM 各自
# 維護自己的一份，內容不同、不互相同步。
#
# 複製方式：直接在該機器上執行
#   cp .env.secrets.example .env.secrets
# 再填入實際值。**不要**跨機器 scp/rsync 這個檔案——deploy/cloud_deploy.sh
# 只同步 .env，永遠不會碰 .env.secrets，這是刻意的。
#
# deploy/trade.sh 的 live 模式會自動 source 這個檔案（連同 .env）再啟動容器。
# =============================================================================

# Binance — 只填在真的會下真單的那台機器（目前是固定 IP 的 VM）。
# 權限：交易（Enable Spot Trading）+ IP 白名單設成 VM 的固定外部 IP
# （不是 Tailscale mesh IP——Binance 看到的是實際對外連線的來源 IP）。
# 本機若只是要抓資料/回測，不需要填這裡——CryptoAdapter() 不帶 key 也能
# fetch_ohlcv；本機真的要手動測下單，另外開一把「唯讀或測試網」的 key，
# 不要跟 VM 這把交易權限的 key 共用。
BINANCE_API_KEY=
BINANCE_API_SECRET=
# 選填：true 時打 Binance sandbox/testnet 而非正式站——跟 mode=live/sim 是
# 兩個獨立的軸：mode 決定策略訊號要不要真的送單，這個決定送到哪個環境。
# 拿來安全地做「live 模式端到端演練」用：mode=live + BINANCE_SANDBOX=true
# 可以驗證整條 策略訊號 → LiveTrader 自動組單 → 下單 的路徑，不動到真錢。
BINANCE_SANDBOX=false

# Shioaji — 平時開發用本機這份唯讀 key；要在 VM 上跑 live 才需要在 VM 自己
# 的 .env.secrets 填入 full 權限 key + CA。兩邊各自維護、不互相同步。
# 憑證檔案放 .secrets/（專案根目錄，.gitignore + .dockerignore 都排除），
# 例如 .secrets/Sinopac.pfx，SHIOAJI_CA_PATH 填相對路徑即可——deploy/trade.sh
# 的 live 模式會自動把 .secrets/ 掛進容器（唯讀），不需要另外手動處理。
#
# 權限：平時開發/抓資料用「唯讀」權限的 key 就好，且不要填 CA_PATH——
# ShioajiAdapter 沒有 CA 就會自動進 read-only 模式，place_order 會直接
# 拋 NotImplementedError，避免不小心打到下單 API。只有真的要本機下單
# 測試時，才切換成「full」權限的 key 並補上 CA_PATH/CA_PASSWORD。
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_PERSON_ID=
SHIOAJI_CA_PATH=.secrets/Sinopac.pfx
SHIOAJI_CA_PASSWORD=
# 選填：true 時 Shioaji 登入永豐的模擬交易環境而非正式站——跟 BINANCE_SANDBOX
# 同一套邏輯，跟 mode=live/sim 正交。同樣可用 mode=live + SHIOAJI_SANDBOX=true
# 做端到端演練，不動到真錢。
SHIOAJI_SANDBOX=false
