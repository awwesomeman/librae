# Trading credentials belong only on the machine that uses them. Copy this
# file to one account-specific .credentials/<account>.env file; never sync it
# between machines. trade.sh passes only the explicitly selected file to
# Docker with --env-file and does not source it as shell code.

# Binance: grant trading only, disable withdrawals, and restrict the key to
# the machine's public IP. Data-only use does not require credentials.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SANDBOX=false

# Shioaji: use read-only credentials without a CA for data access. Live
# trading also requires the CA file under the ignored .secrets/ directory.
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_PERSON_ID=
SHIOAJI_CA_PATH=.secrets/Sinopac.pfx
SHIOAJI_CA_PASSWORD=
SHIOAJI_SANDBOX=false

# IBKR connects to an authenticated TWS or IB Gateway session.
# TWS ports: 7497 paper, 7496 live. Gateway ports: 4002 paper, 4001 live.
# For a gateway on the Docker host, use host.docker.internal; trade.sh adds the
# Linux host-gateway mapping. For a gateway container on quant_network, use its
# service name. Leave this empty when the deployment does not use IBKR.
IBKR_HOST=
IBKR_PORT=7497
IBKR_CLIENT_ID=1
